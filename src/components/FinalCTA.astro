---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const stats = [
  { label: t('finalCta.stat.gateways') },
  { label: t('finalCta.stat.docs') },
  { label: t('finalCta.stat.mcp') },
  { label: t('finalCta.stat.license') },
];
---

<section class="closing" id="closing" aria-label="Get started with STOA">
  <div class="closing-bg">
    <div class="orb orb-teal-lg" data-parallax="0.08"></div>
    <div class="orb orb-purple-lg" data-parallax="0.12"></div>
    <div class="grid-overlay"></div>
  </div>
  <div class="section-container closing-content">
    <h2 class="closing-title reveal" data-reveal set:html={t('finalCta.title').replace('AI agents?', '<br/><span class="gradient-text-alt">AI agents?</span>').replace('agents IA ?', '<br/><span class="gradient-text-alt">agents IA ?</span>')} />
    <p class="closing-desc reveal" data-reveal data-reveal-delay="100">
      {t('finalCta.description')}
    </p>
    <div class="closing-ctas reveal" data-reveal data-reveal-delay="200">
      <a href="mailto:demo@gostoa.dev?subject=STOA%20Demo%20Request" class="btn btn-primary glow-btn btn-lg">
        {t('finalCta.primary')}
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
      <a href="https://docs.gostoa.dev" class="btn btn-secondary btn-lg">
        {t('finalCta.secondary')}
      </a>
    </div>
    <div class="closing-stats reveal" data-reveal data-reveal-delay="300">
      {stats.map((s) => (
        <div class="closing-stat">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="6" stroke="#10b981" stroke-width="1.5" fill="none"/><path d="M6 8l2 2 3-4" stroke="#10b981" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span class="closing-stat-label">{s.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>
