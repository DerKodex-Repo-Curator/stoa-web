---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const metrics = [
  { value: 6, suffix: '', label: t('metrics.gateways'), icon: 'gateway' },
  { value: 101, suffix: '+', label: t('metrics.docs'), icon: 'docs' },
  { value: '', suffix: '', label: t('metrics.mcp'), icon: 'mcp', isText: true, text: 'Full' },
  { value: '', suffix: '', label: t('metrics.deploy'), icon: 'deploy', isText: true, text: 'Hybrid' },
];
---

<section class="metrics" id="metrics" aria-label="Platform Facts">
  <div class="section-container">
    <div class="section-header reveal" data-reveal>
      <span class="section-tag">{t('metrics.tag')}</span>
      <h2 class="section-title" set:html={t('metrics.title')} />
    </div>

    <div class="metrics-grid reveal" data-reveal>
      {metrics.map((m) => (
        <div class="metric-card">
          <span class="metric-value">
            {m.isText ? (
              <span>{m.text}</span>
            ) : (
              <><span data-counter={m.value}>0</span>{m.suffix}</>
            )}
          </span>
          <span class="metric-label">{m.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>
