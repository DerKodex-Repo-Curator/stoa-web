---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const cards = [
  {
    icon: 'shield',
    color: '#ef4444',
    title: t('whyNow.dora.title'),
    subtitle: t('whyNow.dora.subtitle'),
    desc: t('whyNow.dora.description'),
  },
  {
    icon: 'globe',
    color: '#f59e0b',
    title: t('whyNow.cloudAct.title'),
    subtitle: t('whyNow.cloudAct.subtitle'),
    desc: t('whyNow.cloudAct.description'),
  },
  {
    icon: 'bot',
    color: '#8b5cf6',
    title: t('whyNow.agents.title'),
    subtitle: t('whyNow.agents.subtitle'),
    desc: t('whyNow.agents.description'),
  },
];
---

<section class="why-now" id="why-now" aria-label="Why act now">
  <div class="section-container">
    <div class="section-header reveal" data-reveal>
      <span class="section-tag">{t('whyNow.tag')}</span>
      <h2 class="section-title" set:html={t('whyNow.title')} />
      <p class="section-desc">{t('whyNow.description')}</p>
    </div>

    <div class="why-now-grid" data-stagger-parent>
      {cards.map((card, i) => (
        <div class="why-now-card stagger-child" data-stagger={i}>
          <div class="why-now-icon" style={`--card-color: ${card.color}`}>
            {card.icon === 'shield' && (
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
            )}
            {card.icon === 'globe' && (
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg>
            )}
            {card.icon === 'bot' && (
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="10" rx="2"/><circle cx="12" cy="5" r="2"/><path d="M12 7v4"/><circle cx="8" cy="16" r="1" fill="currentColor"/><circle cx="16" cy="16" r="1" fill="currentColor"/></svg>
            )}
          </div>
          <div class="why-now-subtitle">{card.subtitle}</div>
          <h3 class="why-now-title">{card.title}</h3>
          <p class="why-now-desc">{card.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .why-now { padding: clamp(4rem, 8vw, 7rem) 0; }
  .why-now-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; margin-top: 3rem; }
  .why-now-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 2rem;
    transition: border-color 0.3s var(--ease-apple), transform 0.3s var(--ease-apple);
  }
  .why-now-card:hover { border-color: var(--border-hover); transform: translateY(-2px); }
  .why-now-icon {
    width: 48px; height: 48px; border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    background: color-mix(in srgb, var(--card-color) 12%, transparent);
    color: var(--card-color);
    margin-bottom: 1.25rem;
  }
  .why-now-subtitle {
    font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em;
    color: var(--card-color, var(--text-muted)); margin-bottom: 0.5rem;
  }
  .why-now-card:nth-child(1) .why-now-subtitle { color: #ef4444; }
  .why-now-card:nth-child(2) .why-now-subtitle { color: #f59e0b; }
  .why-now-card:nth-child(3) .why-now-subtitle { color: #8b5cf6; }
  .why-now-title { font-size: 1.25rem; font-weight: 700; margin-bottom: 0.75rem; color: var(--text-primary); }
  .why-now-desc { font-size: 0.9375rem; line-height: 1.65; color: var(--text-secondary); }

  @media (max-width: 768px) {
    .why-now-grid { grid-template-columns: 1fr; }
  }
</style>
