---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const weeks = [
  {
    title: t('scenario.week1.title'),
    color: '#10b981',
    steps: [
      t('scenario.week1.step1'),
      t('scenario.week1.step2'),
      t('scenario.week1.step3'),
    ],
  },
  {
    title: t('scenario.week2.title'),
    color: '#8b5cf6',
    steps: [
      t('scenario.week2.step1'),
      t('scenario.week2.step2'),
      t('scenario.week2.step3'),
    ],
  },
  {
    title: t('scenario.week3.title'),
    color: '#2dd4bf',
    steps: [
      t('scenario.week3.step1'),
      t('scenario.week3.step2'),
      t('scenario.week3.step3'),
    ],
  },
];
---

<section class="scenario" id="scenario" aria-label="Banking deployment scenario">
  <div class="section-container">
    <div class="section-header reveal" data-reveal>
      <span class="section-tag">{t('scenario.tag')}</span>
      <h2 class="section-title" set:html={t('scenario.title')} />
      <p class="section-desc">{t('scenario.description')}</p>
    </div>

    <div class="scenario-timeline" data-stagger-parent>
      {weeks.map((week, i) => (
        <div class="scenario-week stagger-child" data-stagger={i}>
          <div class="scenario-week-marker" style={`--week-color: ${week.color}`}>
            <span class="scenario-week-num">{i + 1}</span>
          </div>
          <div class="scenario-week-content">
            <h3 class="scenario-week-title" style={`color: ${week.color}`}>{week.title}</h3>
            <ul class="scenario-steps">
              {week.steps.map((step) => (
                <li>
                  <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="6" stroke={week.color} stroke-width="1.5" fill="none"/><path d="M6 8l2 2 3-4" stroke={week.color} stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  <span>{step}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>

    <p class="scenario-disclaimer reveal" data-reveal>{t('scenario.disclaimer')}</p>
  </div>
</section>

<style>
  .scenario { padding: clamp(4rem, 8vw, 7rem) 0; }
  .scenario-timeline { display: flex; flex-direction: column; gap: 2rem; margin-top: 3rem; position: relative; }
  .scenario-timeline::before {
    content: ''; position: absolute; left: 23px; top: 24px; bottom: 24px; width: 2px;
    background: linear-gradient(to bottom, #10b981, #8b5cf6, #2dd4bf);
    opacity: 0.3; border-radius: 1px;
  }
  .scenario-week { display: flex; gap: 1.5rem; align-items: flex-start; position: relative; }
  .scenario-week-marker {
    flex-shrink: 0; width: 48px; height: 48px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    background: color-mix(in srgb, var(--week-color) 15%, var(--bg-card));
    border: 2px solid color-mix(in srgb, var(--week-color) 40%, transparent);
    z-index: 1;
  }
  .scenario-week-num { font-size: 1.125rem; font-weight: 700; color: var(--text-primary); }
  .scenario-week-content {
    flex: 1; background: var(--bg-card); border: 1px solid var(--border);
    border-radius: 16px; padding: 1.5rem 2rem;
    transition: border-color 0.3s var(--ease-apple);
  }
  .scenario-week-content:hover { border-color: var(--border-hover); }
  .scenario-week-title { font-size: 1.125rem; font-weight: 700; margin-bottom: 1rem; }
  .scenario-steps { display: flex; flex-direction: column; gap: 0.625rem; }
  .scenario-steps li { display: flex; align-items: flex-start; gap: 0.625rem; font-size: 0.9375rem; color: var(--text-secondary); line-height: 1.5; }
  .scenario-steps li svg { flex-shrink: 0; margin-top: 3px; }
  .scenario-disclaimer {
    margin-top: 2rem; font-size: 0.8125rem; color: var(--text-muted);
    font-style: italic; text-align: center;
  }

  @media (max-width: 768px) {
    .scenario-timeline::before { left: 23px; }
    .scenario-week-content { padding: 1.25rem; }
  }
</style>
