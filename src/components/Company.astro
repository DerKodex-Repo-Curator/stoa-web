---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const stackItems = [
  { icon: 'rust', label: t('company.stack.rust'), color: '#f59e0b' },
  { icon: 'python', label: t('company.stack.python'), color: '#10b981' },
  { icon: 'react', label: t('company.stack.react'), color: '#3b82f6' },
];
---

<section class="company" id="company" aria-label="About the company">
  <div class="section-container">
    <div class="section-header reveal" data-reveal>
      <span class="section-tag">{t('company.tag')}</span>
      <h2 class="section-title" set:html={t('company.title')} />
      <p class="section-desc">{t('company.description')}</p>
    </div>

    <div class="company-grid reveal" data-reveal>
      <div class="company-card company-card-founder">
        <div class="company-card-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        </div>
        <h3 class="company-card-title">{t('company.founder.role')}</h3>
        <p class="company-card-desc">{t('company.founder.description')}</p>
      </div>

      <div class="company-card company-card-stack">
        <div class="company-card-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#8b5cf6" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2"/><path d="M9 9l3 3-3 3"/><path d="M14 15h3"/></svg>
        </div>
        <h3 class="company-card-title">{t('company.stack.title')}</h3>
        <ul class="company-stack-list">
          {stackItems.map((item) => (
            <li>
              <span class="company-stack-dot" style={`background: ${item.color}`}></span>
              <span>{item.label}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="company-positioning reveal" data-reveal>
      <div class="company-positioning-inner">
        <span class="company-positioning-flag">&#127466;&#127482;</span>
        <p>{t('company.positioning')}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .company { padding: clamp(4rem, 8vw, 7rem) 0; }
  .company-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 2rem; margin-top: 3rem; }
  .company-card {
    background: var(--bg-card); border: 1px solid var(--border); border-radius: 16px;
    padding: 2rem; transition: border-color 0.3s var(--ease-apple);
  }
  .company-card:hover { border-color: var(--border-hover); }
  .company-card-icon {
    width: 48px; height: 48px; border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    background: var(--bg-elevated); margin-bottom: 1.25rem;
  }
  .company-card-title { font-size: 1.125rem; font-weight: 700; color: var(--text-primary); margin-bottom: 0.75rem; }
  .company-card-desc { font-size: 0.9375rem; line-height: 1.65; color: var(--text-secondary); }
  .company-stack-list { display: flex; flex-direction: column; gap: 0.625rem; }
  .company-stack-list li { display: flex; align-items: flex-start; gap: 0.75rem; font-size: 0.9375rem; color: var(--text-secondary); line-height: 1.5; }
  .company-stack-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; margin-top: 7px; }
  .company-positioning { margin-top: 2rem; }
  .company-positioning-inner {
    display: flex; align-items: center; gap: 1rem;
    background: color-mix(in srgb, var(--emerald-500) 8%, var(--bg-card));
    border: 1px solid color-mix(in srgb, var(--emerald-500) 20%, transparent);
    border-radius: 12px; padding: 1.25rem 1.5rem;
  }
  .company-positioning-flag { font-size: 1.5rem; flex-shrink: 0; }
  .company-positioning-inner p { font-size: 0.9375rem; font-weight: 500; color: var(--text-primary); line-height: 1.5; }

  @media (max-width: 768px) {
    .company-grid { grid-template-columns: 1fr; }
  }
</style>
